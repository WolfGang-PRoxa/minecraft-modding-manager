{
  "name": "minecraft-modpack-manager",
  "productName": "Modpack Manager",
  "version": "1.8.3",
  "description": "Installe les modpacks Minecraft publiés sur GitHub dans CurseForge, et aide leurs auteurs à les tenir à jour.",
  "author": "WolfGang-PRoxa",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run docs:verifier && npm test && electron-vite build",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p relay/tsconfig.json",
    "docs:verifier": "tsx scripts/docs.ts",
    "changelog": "tsx scripts/changelog.ts",
    "build:win": "npm run build && tsx scripts/generate-installer-images.ts && electron-builder --win --publish never",
    "preview": "electron-vite preview",
    "studio": "electron-vite dev -- --studio",
    "mpm": "tsx src/cli/index.ts",
    "modpacks:ranger": "tsx src/cli/index.ts ranger",
    "modpacks:publier": "tsx src/cli/index.ts publier"
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "archiver": "^8.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
