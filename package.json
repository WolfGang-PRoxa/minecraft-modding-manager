{
  "name": "minecraft-modding-manager",
  "productName": "Modding Manager",
  "version": "2.6.0",
  "description": "Installe les modpacks Minecraft publiés sur GitHub dans CurseForge, et aide leurs auteurs à les tenir à jour.",
  "author": "WolfGang-PRoxa",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run docs:verifier && npm test && electron-vite build",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p relay/tsconfig.json",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check": "prettier --check . && eslint . && npm run typecheck && npm run docs:verifier",
    "docs:verifier": "tsx scripts/docs.ts",
    "changelog": "tsx scripts/changelog.ts",
    "build:win": "npm run build && tsx scripts/generate-installer-images.ts && electron-builder --win --publish never",
    "preview": "electron-vite preview",
    "studio": "electron-vite dev -- --studio",
    "mpm": "tsx src/cli/index.ts",
    "modpacks:ranger": "tsx src/cli/index.ts ranger",
    "modpacks:publier": "tsx src/cli/index.ts publier"
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "archiver": "^8.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "lucide-react": "^1.48.0",
    "prettier": "^3.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.6",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
